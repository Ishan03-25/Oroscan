// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output = "../lib/generated/prisma"
  // Include the rhel OpenSSL build so deployments on Vercel (rhel) work
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  username      String    @unique
  name          String?
  password      String
  isDoctor      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  patients      Patient[]
}

model Patient {
  id              String    @id @default(cuid())
  name            String
  age             Int
  gender          String
  phone           String
  healthAssistant String?
  address         String
  doctorId        String
  doctor          User      @relation(fields: [doctorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  responses       Response[]
  images          Image[]
  diagnoses       Diagnosis[]
}

model Response {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])
  answer      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Question {
  id          String    @id @default(cuid())
  category    String    // medical, family, features
  text        String
  type        String    // text, boolean, choice, image-select
  options     String?   // JSON array of options for choice questions
  responses   Response[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Image {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  url         String   // S3 URL
  type        String   // device-upload, asymmetry, patches, lumps, trismus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Diagnosis {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  result      String   // AI/ML analysis result
  confidence  Float    // Confidence score from AI/ML model
  metadata    Json?    // Additional metadata from AI/ML analysis
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId           String
  type             String
  provider         String
  providerAccountId String
  refresh_token    String? @db.Text
  access_token     String? @db.Text
  expires_at       Int?
  token_type       String?
  scope            String?
  id_token         String? @db.Text
  session_state    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
